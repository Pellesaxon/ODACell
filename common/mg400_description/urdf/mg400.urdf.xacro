<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="mg400_base">
  <!-- Macro definition: prefix all names, and attach base_link to 'world' at given pose -->
  <xacro:macro name="mg400" params="prefix xyz rpy">
    <!-- Fixed joint to attach this instance to the world -->
    <joint name="${prefix}fixed_to_world" type="fixed">
      <parent link="world"/>
      <child link="${prefix}base_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Begin original MG400 description, with all names prefixed -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="0.000600637 -0.000000253 0.056092789" rpy="0 0 0"/>
        <mass value="3.62164811695"/>
        <inertia ixx="0.01265821753" ixy="6.66832e-08" ixz="-3.52548e-06"
                 iyy="0.01458915353" iyz="5.15902e-08" izz="0.01950451167"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://mg400_description/meshes/base_link.STL"/>
        </geometry>
        <material name="base_link_material"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://mg400_description/meshes/base_link.STL"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}link1">
    <inertial>
      <origin xyz="-0.0046209286967387 -6.88107982318643E-05 0.0709919358465827" rpy="0 0 0"/>
      <mass value="1.77056222753813"/>
      <inertia
        ixx="0.00605885293080088" ixy="0.000156081820035162" ixz="-0.00021785654850453"
        iyy="0.00579381982249127" iyz="6.20876898015621E-05" izz="0.00741058257251941"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mg400_description/meshes/link1.STL"/>
      </geometry>
      <material name="link1_material">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mg400_description/meshes/link1.STL"/>
      </geometry>
    </collision>
  </link>
    <joint name="${prefix}j1" type="revolute">
      <origin xyz="-0.005 0 0.109" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.1416" upper="3.1416" effort="0" velocity="0"/>
    </joint>
        <link name="${prefix}link2_1">
      <inertial>
        <origin xyz="-0.003217885247567 0.0352926570826593 0.0596131328734945" rpy="0 0 0"/>
        <mass value="0.0866115884541459"/>
        <inertia ixx="0.000338551627157209" ixy="-2.78858228577314e-09" ixz="1.05212346076681e-05"
                 iyy="0.000307789653713489" iyz="-1.36109590152488e-06" izz="3.89949940178023e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link2_1.STL"/></geometry>
        <material name="link2_1_material"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link2_1.STL"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}j2" type="revolute">
      <origin xyz="0.0435007595118091 -0.0357748756218899 0.118995682641123" rpy="0 0 0"/>
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2_1"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.14" upper="1.39" effort="0" velocity="0"/>
    </joint>

    <link name="${prefix}link3_1">
      <inertial>
        <origin xyz="0.0821679417596488 0.000113044685842874 -0.00333758753063973" rpy="0 0 0"/>
        <mass value="0.0375214831045061"/>
        <inertia ixx="2.54761091812684e-06" ixy="3.73102654491378e-07" ixz="-2.02625705871199e-06"
                 iyy="0.000164234314177935" iyz="-1.44731096825347e-08" izz="0.000164331500854172"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link3_1.STL"/></geometry>
        <material name="link3_1_material"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link3_1.STL"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}j3_1" type="revolute">
      <parent link="${prefix}fake_link"/>
      <child link="${prefix}link3_1"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="0" velocity="0"/>
      <mimic joint="${prefix}j3_2"/>
    </joint>

    <link name="${prefix}link4_1">
      <inertial>
        <origin xyz="0.0387878182928232 0.0170848333998282 -0.0024610990490942" rpy="0 0 0"/>
        <mass value="0.0628979533925801"/>
        <inertia ixx="4.78483605712844e-05" ixy="1.42081909356751e-07" ixz="8.32917079044309e-06"
                 iyy="5.42362047732042e-05" iyz="-2.90608446019989e-08" izz="3.36120409842199e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link4_1.STL"/></geometry>
        <material name="link4_1_material"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link4_1.STL"/></geometry>
      </collision>
    </link>

    <link name="${prefix}fake_link"/>
    <joint name="${prefix}j3" type="revolute">
      <origin xyz="-0.0010512570171516 0.0357748756218898 0.175001164344716" rpy="0 0 0"/>
      <parent link="${prefix}link2_1"/>
      <child link="${prefix}fake_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="1.39" effort="0" velocity="0"/>
    </joint>

    <joint name="${prefix}j4_1" type="revolute">
      <origin xyz="0.174969784055705 -0.0170000000000335 0.00325187137614585" rpy="0 0 0"/>
      <parent link="${prefix}link3_1"/>
      <child link="${prefix}link4_1"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="0" velocity="0"/>
      <mimic joint="${prefix}j4_2" multiplier="-1"/>
    </joint>

    <link name="${prefix}link5">
      <inertial>
        <origin xyz="0 0 -0.0349688816440933" rpy="0 0 0"/>
        <mass value="0.0965276919819365"/>
        <inertia ixx="4.98589992160928e-05" ixy="-1.534865545378e-12" ixz="3.46424449605658e-10"
                 iyy="4.98589881725446e-05" iyz="-5.64890953414983e-17" izz="2.130463008359e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link5.STL"/></geometry>
        <material name="link5_material"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link5.STL"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}j4" type="revolute">
      <origin xyz="0.0659996239003897 0.0170000000000371 0.031000800715573" rpy="0 0 0"/>
      <parent link="${prefix}link4_1"/>
      <child link="${prefix}link5"/>
      <axis xyz="-1.19408295462994e-05 0 0.999999999928708"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="0" velocity="0"/>
    </joint>

    <link name="${prefix}link2_2">
      <inertial>
        <origin xyz="-0.0201111131723385 0.0304999635268521 0.073632809340276" rpy="0 0 0"/>
        <mass value="0.0662546292985346"/>
        <inertia ixx="0.000218973873589181" ixy="3.0147933007673e-10" ixz="2.51402553227571e-06"
                 iyy="0.000200510070261609" iyz="-1.41837669904595e-09" izz="3.74316777806776e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link2_2.STL"/></geometry>
        <material name="link2_2_material"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link2_2.STL"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}j2_2" type="revolute">
      <origin xyz="0.00452885682964267 -0.0305 0.1415" rpy="0 0 0"/>
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2_2"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="0" velocity="0"/>
      <mimic joint="${prefix}j2"/>
    </joint>

    <link name="${prefix}link3_2">
      <inertial>
        <origin xyz="0.0338566736074436 0.0240208873857428 0.00452229895926692" rpy="0 0 0"/>
        <mass value="0.0366692789294813"/>
        <inertia ixx="7.24011830695354e-06" ixy="7.93542746250724e-10" ixz="-1.69163254472566e-06"
                 iyy="2.34967008246727e-05" iyz="4.55507111386579e-10" izz="1.66831643179488e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link3_2.STL"/></geometry>
        <material name="link3_2_material"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link3_2.STL"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}j3_2" type="revolute">
      <origin xyz="-0.00105049750546494 0.0065 0.174996846985851" rpy="0 0 0"/>
      <parent link="${prefix}link2_2"/>
      <child link="${prefix}link3_2"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="0" velocity="0"/>
      <mimic joint="${prefix}j2_2" multiplier="-1"/>
    </joint>

    <link name="${prefix}link4_2">
      <inertial>
        <origin xyz="0.0876391591012518 0.023499867452275 0.00831492252441945" rpy="0 0 0"/>
        <mass value="0.0453569016333092"/>
        <inertia ixx="2.00037596001325e-05" ixy="3.34474706250153e-09" ixz="2.17594982354756e-07"
                 iyy="0.000132049841023893" iyz="5.36978669669685e-10" izz="0.000141813978894428"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link4_2.STL"/></geometry>
        <material name="link4_2_material"><color rgba="1 1 1 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://mg400_description/meshes/link4_2.STL"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}j4_2" type="revolute">
      <origin xyz="0.0678965856063864 0.0005 0.0119719999403219" rpy="0 0 0"/>
      <parent link="${prefix}link3_2"/>
      <child link="${prefix}link4_2"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159265" upper="3.14159265" effort="0" velocity="0"/>
      <mimic joint="${prefix}j3"/>
    </joint>

    <link name="${prefix}tool_link">
      <inertial>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.13" rpy="0 0 0"/>
        <geometry><box size="0.04 0.04 0.10"/></geometry>
        <material name="tool_mat"><color rgba="0.8 0.2 0.2 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 -0.13" rpy="0 0 0"/>
        <geometry><box size="0.04 0.04 0.10"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}tool_fixed_joint" type="fixed">
      <parent link="${prefix}link5"/>
      <child link="${prefix}tool_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>

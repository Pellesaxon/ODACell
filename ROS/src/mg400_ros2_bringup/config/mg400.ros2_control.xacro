<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    This file defines the ros2_control interfaces for the MG400 robot.
    It specifies the hardware plugin, the commandable joints, and their state interfaces.
    The joint limit parameters are passed from the main URDF xacro.
  -->

  <xacro:macro name="mg400_ros2_control" params="
    j1_lower_limit
    j1_upper_limit
    j2_lower_limit
    j2_upper_limit
    j3_lower_limit
    j3_upper_limit
    j4_lower_limit
    j4_upper_limit">
    
    <ros2_control name="MG400SystemHardware" type="system">
      <hardware>
        <!-- This plugin connects ros2_control to the C++ hardware interface -->
        <plugin>mg400_ros2_bringup/MG400SystemHardware</plugin>
      </hardware>

      <!-- Define the commandable joints for the controller manager -->

      <!-- Joint 1 -->
      <joint name="j1">
        <command_interface name="position">
          <param name="min">${j1_lower_limit}</param>
          <param name="max">${j1_upper_limit}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Joint 2 -->
      <joint name="j2">
        <command_interface name="position">
          <param name="min">${j2_lower_limit}</param>
          <param name="max">${j2_upper_limit}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Joint 3 -->
      <joint name="j3">
        <command_interface name="position">
          <param name="min">${j3_lower_limit}</param>
          <param name="max">${j3_upper_limit}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Joint 4 -->
      <joint name="j4">
        <command_interface name="position">
          <param name="min">${j4_lower_limit}</param>
          <param name="max">${j4_upper_limit}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>
  </xacro:macro>

</robot>
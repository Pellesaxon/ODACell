<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    This file defines the ros2_control interfaces for the MG400 robot.
    It specifies the hardware plugin, the commandable joints, and their mimic relationships.
  -->

  <xacro:macro name="mg400_ros2_control">
    <ros2_control name="MG400SystemHardware" type="system">
      <hardware>
        <plugin>mg400_ros2_bringup/MG400SystemHardware</plugin>
        <!-- The robot_ip parameter will be passed from the top-level xacro -->
      </hardware>

      <!-- Define the master, commandable joints -->
      <!-- These are the joints our hardware interface will directly read/write -->
      <joint name="j1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="j2_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="j3_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="j4_1">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="j5">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Define the mimic joints for the parallel linkages -->
      <!-- ros2_control will automatically set the state of these joints based on their master -->
      <joint name="j2_2">
        <mimic_joint name="j2_1" multiplier="1" offset="0"/>
      </joint>
      
      <joint name="j3_2">
        <mimic_joint name="j3_1" multiplier="1" offset="0"/>
      </joint>
      
      <joint name="j4_2">
        <mimic_joint name="j4_1" multiplier="1" offset="0"/>
      </joint>

    </ros2_control>
  </xacro:macro>

</robot>
<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    This file defines the ros2_control interfaces for the MG400 robot.
    It specifies the hardware plugin, the commandable joints, and their state interfaces.
    The joint limit parameters are passed from the main URDF xacro.
  -->

  <xacro:macro name="mg400_mock_ros2_control">
    <ros2_control name="MockMG400" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <!-- This plugin connects ros2_control to the C++ hardware interface -->
        <!-- <plugin>mg400_ros2_bringup/MockMG400SystemHardware</plugin> -->
      </hardware>

      <!-- Define the commandable joints for the controller manager -->

      <!-- Joint 1 -->
      <joint name="j1">
        <command_interface name="position">
          <param name="min">${J1_MIN_RAD}</param>
          <param name="max">${J1_MAX_RAD}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Joint 2 -->
      <joint name="j2">
        <command_interface name="position">
          <param name="min">${J2_MIN_RAD}</param>
          <param name="max">${J2_MAX_RAD}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Joint 3 -->
      <joint name="j3">
        <command_interface name="position">
          <param name="min">${J3_MIN_RAD}</param>
          <param name="max">${J3_MAX_RAD}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Joint 4 -->
      <joint name="j4">
        <command_interface name="position">
          <param name="min">${J4_MIN_RAD}</param>
          <param name="max">${J4_MAX_RAD}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <command_interface name="acceleration"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>
  </xacro:macro>

</robot>